.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 80px;
}

.section {
  margin-top: 20px;
}

.section-title {
  font-size: 12px;
  color: var(--color-text-mid);
  font-weight: 600;
  padding: 0 16px;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.about-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.about-label {
  font-size: 15px;
  color: var(--color-text);
  font-weight: 600;
}

.about-version {
  font-size: 13px;
  color: var(--color-text-mid);
}

.about-desc {
  font-size: 13px;
  color: var(--color-text-soft);
  padding: 12px 16px;
  line-height: 1.6;
}

/* ===== Danger Zone ===== */
.danger-list {
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.danger-item {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.danger-label {
  font-size: 15px;
  font-weight: 500;
  color: var(--color-red);
}

.danger-sub {
  font-size: 12px;
  color: var(--color-text-mid);
}

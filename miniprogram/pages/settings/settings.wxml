<view class="page">
  <view class="section">
    <view class="section-title">管理事项</view>
    <view class="item-list">
      <view class="setting-item" wx:for="{{items}}" wx:key="id">
        <view class="item-left">
          <text class="item-icon">{{item.icon}}</text>
          <text class="item-name">{{item.name}}</text>
        </view>
        <view class="item-right">
          <view class="delete-btn" data-id="{{item.id}}" catchtap="onDeleteItem">删除</view>
        </view>
      </view>
    </view>
    <view class="add-row" bindtap="onAddItem">
      <text class="add-icon">+</text>
      <text class="add-text">添加事项</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">关于</view>
    <view class="about-item">
      <text class="about-label">过门不忘</text>
      <text class="about-version">v1.0.0</text>
    </view>
    <view class="about-desc">
      告别"门口"效应，大脑重启前轻松留痕，安心转身向前走
    </view>
  </view>
</view>

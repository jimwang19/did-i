.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 80px;
}

.status-bar-placeholder {
  background: var(--color-bg);
}

.page-header {
  padding: 8px 20px 4px;
}

.header-title {
  font-size: 22px;
  font-weight: 500;
  color: var(--color-text);
  letter-spacing: -0.02em;
}

/* Filter bar */
.filter-bar {
  display: flex;
  gap: 8px;
  padding: 8px 16px 12px;
}

.filter-chip {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 13px;
  color: var(--color-text-soft);
}

.filter-chip.active {
  background: var(--color-accent-soft);
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.filter-arrow {
  font-size: 10px;
  opacity: 0.6;
}

.history-list {
  padding: 0 16px;
}

.day-group {
  margin-bottom: 16px;
}

.day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12px;
  color: var(--color-text-mid);
  font-weight: 600;
  padding: 8px 4px;
  letter-spacing: 0.02em;
}

.day-label {
  flex: 1;
}

.collapse-icon {
  font-size: 10px;
  color: var(--color-text-mid);
  opacity: 0.6;
}

.records-wrap.collapsed {
  display: none;
}

.record {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  margin-bottom: 4px;
  border-left: 3px solid var(--color-success);
}

.record-icon {
  font-size: 20px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.04);
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 15px;
  font-weight: 500;
  color: var(--color-text);
  display: block;
}

.record-meta {
  font-size: 12px;
  color: var(--color-text-soft);
  margin-top: 2px;
}

.record-badge {
  font-size: 16px;
  flex-shrink: 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48px 0;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 15px;
  color: var(--color-text-soft);
}

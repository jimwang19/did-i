<view class="page">
  <!-- 状态栏占位 -->
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>

  <view class="page-header">
    <text class="header-title">历史</text>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <picker mode="selector" range="{{itemLabels}}" value="{{filterItemIndex}}" bindchange="onItemFilterChange">
      <view class="filter-chip {{filterItemIndex > 0 ? 'active' : ''}}">
        <text>{{itemLabels[filterItemIndex]}}</text>
        <text class="filter-arrow">▾</text>
      </view>
    </picker>
    <picker mode="selector" range="{{daysLabels}}" value="{{filterDaysIndex}}" bindchange="onDaysFilterChange">
      <view class="filter-chip {{filterDaysIndex > 0 ? 'active' : ''}}">
        <text>{{daysLabels[filterDaysIndex]}}</text>
        <text class="filter-arrow">▾</text>
      </view>
    </picker>
  </view>

  <view class="history-list">
    <view class="day-group" wx:for="{{historyGroups}}" wx:key="date">
      <view class="day-header" data-date="{{item.date}}" bindtap="toggleGroup">
        <text class="day-label">{{item.dateLabel}}</text>
        <text class="collapse-icon">{{item.collapsed ? '▶' : '▼'}}</text>
      </view>
      <view class="records-wrap {{item.collapsed ? 'collapsed' : ''}}">
        <view class="record" wx:for="{{item.records}}" wx:for-item="record" wx:key="timestamp"
          data-icon="{{record.itemIcon}}" data-name="{{record.itemName}}"
          data-date="{{item.date}}" data-time="{{record.timestampShort}}"
          data-method="{{record.method}}" data-photo="{{record.photoPath}}"
          bindtap="onRecordTap">
          <view class="record-icon">{{record.itemIcon}}</view>
          <view class="record-info">
            <text class="record-name">{{record.itemName}}</text>
            <view class="record-meta">
              <text class="record-time">{{record.timestampShort}}</text>
              <text wx:if="{{record.method === 'camera'}}"> · 拍照</text>
            </view>
          </view>
          <view class="record-badge confirmed" wx:if="{{record.method === 'button'}}">✅</view>
          <view class="record-badge" wx:else>📷</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{historyGroups.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无历史记录</text>
    </view>
  </view>

  <!-- 确认详情 Sheet -->
  <detail-sheet visible="{{detailVisible}}" detail="{{detailData}}" bind:close="onDetailClose"></detail-sheet>
</view>

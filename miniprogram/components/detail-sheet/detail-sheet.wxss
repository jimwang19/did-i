.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.25s ease;
}

.mask.visible {
  background: rgba(0, 0, 0, 0.6);
  pointer-events: auto;
}

.sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--color-surface);
  border-radius: 20px 20px 0 0;
  padding: 12px 20px 40px;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.sheet.visible {
  transform: translateY(0);
}

.handle {
  width: 36px;
  height: 4px;
  background: var(--color-border);
  border-radius: 99px;
  margin: 0 auto 20px;
}

/* ===== Header ===== */
.sheet-header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-bottom: 16px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--color-border);
}

.icon {
  font-size: 32px;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.header-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.name {
  font-size: 18px;
  font-weight: 600;
  color: var(--color-text);
}

.sub {
  font-size: 12px;
  color: var(--color-text-mid);
}

/* ===== Detail Rows ===== */
.rows {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 20px;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-label {
  font-size: 14px;
  color: var(--color-text-mid);
}

.row-value {
  font-size: 14px;
  color: var(--color-text);
  font-weight: 500;
}

.method-badge {
  padding: 4px 12px;
  border-radius: 99px;
  font-size: 13px;
  font-weight: 500;
}

.method-badge.button {
  background: rgba(129, 199, 132, 0.15);
  color: var(--color-success);
}

.method-badge.camera {
  background: rgba(78, 205, 196, 0.15);
  color: var(--color-accent);
}

/* ===== Photo ===== */
.photo-block {
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.photo {
  width: 100%;
  height: 180px;
  border-radius: var(--radius-md);
}

.photo-hint {
  font-size: 11px;
  color: var(--color-text-mid);
  text-align: center;
}

/* ===== Photo Expired ===== */
.photo-expired {
  margin-bottom: 20px;
  padding: 14px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.04);
  border: 1px dashed rgba(255, 255, 255, 0.1);
  text-align: center;
}

.photo-expired-text {
  font-size: 13px;
  color: var(--color-text-mid);
}

/* ===== Close Button ===== */
.close-btn {
  padding: 14px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.06);
  text-align: center;
  font-size: 15px;
  font-weight: 500;
  color: var(--color-text-soft);
}
